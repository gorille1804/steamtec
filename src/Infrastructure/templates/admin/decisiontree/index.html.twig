{% extends "layout/dashboard.layout.html.twig" %}
{% block title %} Arbre de Dépannage {% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/admin/decisiontree/decision-tree.css') }}">
    <style>
        /* Masquer la scrollbar de l'iframe tout en permettant le scroll */
        iframe::-webkit-scrollbar {
            display: none; /* masque la scrollbar sur WebKit (Chrome, Safari, Edge) */
        }
        
        /* Pour Firefox */
        iframe {
            scrollbar-width: none; /* masque la scrollbar sur Firefox */
            -ms-overflow-style: none; /* masque la scrollbar sur IE/Edge */
        }
        
        /* S'assurer que l'iframe peut scroller même sans scrollbar visible */
        #decision-tree-iframe {
            overflow: auto;
            height: 300vh;
        }
    </style>
{% endblock %}

{% block content %}
<div class="row flex-grow">
    <div class="col-md-12">
        <!-- Onglet Mermaid -->
        <iframe id="decision-tree-iframe" src="{{ path('decisiontree_interactif') }}" width="100%" style="border: none; min-height: 400px; overflow: auto;"></iframe>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const iframe = document.getElementById('decision-tree-iframe');
        iframe.addEventListener('load', function() {
            const doc = iframe.contentWindow.document;
            const height = doc.body.scrollHeight;
            iframe.style.height = height + 'px';
        });
    });
</script>
{% endblock %}
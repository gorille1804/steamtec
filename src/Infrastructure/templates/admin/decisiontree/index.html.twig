{% extends "layout/dashboard.layout.html.twig" %}
{% block title %} Arbre de Dépannage {% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/admin/decisiontree/decision-tree.css') }}">
{% endblock %}

{% block content %}
<div class="row flex-grow">
    <div class="col-md-12">
        <!-- Onglets -->
        <ul class="nav nav-tabs" id="decisionTreeTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="{{ path('app_arbre_de_depannage') }}" class="nav-link active" id="interactive-tab" type="button">
                    <i class="mdi mdi-format-list-bulleted me-2"></i>Diagramme de flux
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="{{ path('decisiontree_interactif') }}" class="nav-link" id="mermaid-tab" type="button">
                    <i class="mdi mdi-chart-sankey me-2"></i>Arbre de décision interactif
                </a>
            </li>
        </ul>

        <!-- Contenu des onglets -->
        <div class="tab-content" id="decisionTreeTabContent">
            <!-- Onglet interactif -->
            <div class="tab-pane fade show active" id="interactive" role="tabpanel" aria-labelledby="interactive-tab">
                <div class="mt-3">
                    <div id="decision-tree-breadcrumb" class="mb-3"></div>
                    <div id="decision-tree-app" data-json-url="{{ asset('assets/data/decision-tree.json') }}"></div>
                </div>
            </div>

            <!-- Onglet Mermaid -->
            <div class="tab-pane fade" id="mermaid" role="tabpanel" aria-labelledby="mermaid-tab">
                <div class="iframe-container">
                    <iframe src="{{ path('decisiontree_interactif') }}"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/mermaid@10.6.1/dist/mermaid.min.js"></script>
<script src="{{ asset('assets/js/decision-tree.js?t=202507022') }}"></script>
{% endblock %}
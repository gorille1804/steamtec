<script>
    // Définir l'URL du JSON avant le chargement du script principal
    window.jsonUrl = "{{ asset('assets/data/decision-tree.json') }}";
    console.log('JSON URL définie:', window.jsonUrl);
    
    // Fonction pour envoyer la hauteur à la page parent
    function sendHeightToParent() {
        const height = Math.max(
            document.body.scrollHeight,
            document.body.offsetHeight,
            document.documentElement.clientHeight,
            document.documentElement.scrollHeight,
            document.documentElement.offsetHeight
        );
        
        // Envoyer la hauteur à la page parent
        if (window.parent && window.parent !== window) {
            window.parent.postMessage({
                type: 'iframe-height',
                height: height
            }, '*');
        }
    }
    
    // Attendre que le DOM soit chargé avant d'initialiser l'application
    document.addEventListener('DOMContentLoaded', function() {
        console.log('DOM chargé, chargement du script principal...');
        
        // Charger le script principal de manière asynchrone
        const script = document.createElement('script');
        script.src = "{{ asset('assets/js/decision-tree-interactive.js?t=202507022') }}";
        script.onload = function() {
            console.log('Script principal chargé');
            // Envoyer la hauteur après le chargement du script
            setTimeout(sendHeightToParent, 200);
        };
        script.onerror = function() {
            console.error('Erreur lors du chargement du script principal');
        };
        document.head.appendChild(script);
        
        // Envoyer la hauteur initiale
        setTimeout(sendHeightToParent, 100);
    });
    
    // Observer les changements de taille du contenu
    if (window.ResizeObserver) {
        const resizeObserver = new ResizeObserver(function() {
            sendHeightToParent();
        });
        
        // Observer le body et le document
        resizeObserver.observe(document.body);
        resizeObserver.observe(document.documentElement);
    }
    
    // Envoyer la hauteur lors des changements de contenu
    window.addEventListener('resize', function() {
        setTimeout(sendHeightToParent, 100);
    });
</script>
{% extends "layout/dashboard.layout.html.twig" %}
{% block title %}Gestion des machines - {{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block content %}
<div class="row flex-grow">
    <div class="col-md-12">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}
    </div>
    <div class="col-12 grid-margin stretch-card">
        <div class="card card-rounded">
            <div class="card-body">
                <div class="d-sm-flex justify-content-between align-items-start">
                    <div>
                        <h2 class="card-title card-title-dash">
                            Gestion des machines - {{ user.firstname }} {{ user.lastname }}
                            <small class="text-muted">({{ user.email }})</small>
                        </h2>
                    </div>
                    <div>
                        <a href="{{ path('app_users') }}" class="btn btn-secondary btn-sm">
                            <i class="mdi mdi-arrow-left-bold"></i> Retour à la liste des utilisateurs
                        </a>
                    </div>
                                 </div>
                
                <!-- Formulaire d'ajout de machine -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title">Ajouter une machine</h5>
                            </div>
                            <div class="card-body">
                                {{ form_start(addMachineForm) }}
                                <div class="form-group">
                                    {{ form_label(addMachineForm.machine) }}
                                    {{ form_widget(addMachineForm.machine) }}
                                    {{ form_errors(addMachineForm.machine) }}
                                </div>
                                <div class="form-group">
                                    {{ form_widget(addMachineForm.add) }}
                                </div>
                                {{ form_end(addMachineForm) }}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Liste des machines affectées -->
                <div class="row">
                    <div class="col-12">
                        <h5 class="card-title">Machines affectées ({{ assignedMachines|length }})</h5>
                                    {% if assignedMachines is empty %}
                                        <div class="alert alert-info">
                                            <i class="mdi mdi-information"></i>
                                            Aucune machine n'est actuellement affectée à cet utilisateur.
                                        </div>
                                    {% else %}
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                                                                 <thead>
                                                     <tr>
                                                         <th>Nom</th>
                                                         <th>Numéro d'identification</th>
                                                         <th>Marque</th>
                                                         <th>Actions</th>
                                                     </tr>
                                                 </thead>
                                                <tbody>
                                                                                                         {% for machine in assignedMachines %}
                                                         <tr>
                                                             <td>{{ machine.nom }}</td>
                                                             <td>{{ machine.numeroIdentification }}</td>
                                                             <td>{{ machine.marque }}</td>
                                                            <td>
                                                                <form method="post" action="{{ path('app_remove_machine_from_user', {'user': user.id.value, 'machine': machine.id.value}) }}" style="display: inline;">
                                                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir retirer cette machine de cet utilisateur ?')">
                                                                        <i class="mdi mdi-delete"></i> Retirer
                                                                    </button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                                                         {% endif %}
                                 </div>
                             </div>
                         </div>
                     </div>
                 </div>
             </div>
         </div>
     </div>
{% endblock %}

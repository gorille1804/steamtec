{% extends "layout/dashboard.layout.html.twig" %}
{% block title %} {{'users.index.title'|trans}} {% endblock %}

{% block content %}
    <div class="row flex-grow">
        <div class="col-md-12">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}
        </div>
        <div class="col-12 grid-margin stretch-card">
            <div class="card card-rounded">
                <div class="card-body">
                    <div class="d-sm-flex justify-content-between align-items-start">
                        <div>
                            <h2 class="card-title card-title-dash">{{'users.index.list'|trans}}</h2>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <!-- Formulaire de recherche -->
                            <form method="GET" action="{{ path('app_users') }}" class="d-flex">
                                <div class="input-group" style="min-width: 300px;">
                                    <input type="text" 
                                           class="form-control" 
                                           name="search" 
                                           value="{{ search }}" 
                                           placeholder="{{ 'users.index.search.placeholder'|trans }}"
                                           aria-label="{{ 'users.index.search.label'|trans }}">
                                    <button class="btn btn-outline-secondary" type="submit">
                                        <i class="mdi mdi-magnify"></i>
                                    </button>
                                    {% if search %}
                                        <a href="{{ path('app_users') }}" class="btn btn-outline-danger" type="button" title="{{ 'users.index.search.clear'|trans }}">
                                            <i class="mdi mdi-close"></i>
                                        </a>
                                    {% endif %}
                                </div>
                            </form>
                            <a href="{{path('app_users_create')}}" class="btn btn-primary btn-md text-white mb-0 me-0" type="button">
                                <i class="mdi mdi-account-plus"></i> {{'users.index.btn_create_new'|trans}}
                            </a>
                        </div>
                    </div>
                    
                    <!-- Affichage des résultats de recherche -->
                    {% if search %}
                        <div class="row mt-3">
                            <div class="col-12">
                                <p class="text-muted mb-0">
                                    <i class="mdi mdi-information-outline"></i>
                                    {{ totalUsers }} {{ 'users.index.search.info'|trans }} "{{ search }}"
                                </p>
                            </div>
                        </div>
                    {% endif %}
                    <div class="table-responsive mt-1">
                        <table class="table select-table">
                            <thead>
                                <tr>
                                    <th>{{'users.index.client'|trans}}</th>
                                    <th>{{'users.index.mail'|trans}}</th>
                                    <th>{{'users.index.society'|trans}}</th>
                                    <th>{{'users.index.phone'|trans}}</th>
                                    <th>{{'users.index.status'|trans}}</th>
                                    <th>{{'users.index.action'|trans}}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for user in users %} 
                                <tr>
                                    <td>
                                        {{user.firstname ~ ' ' ~ user.lastname}}
                                        {% if app.user.id == user.id %}
                                             <p class="badge badge-opacity-success">vous</p>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{user.email}}
                                    </td>
                                    <td>
                                       {{user.socity}}
                                    </td>
                                    <td>
                                      {{user.phone}}  
                                    </td>
                                    <td>
                                        {% if user.isActive %}
                                            <span class="badge badge-success">{{'users.index.statusLbl.active'|trans}}</span>
                                        {% else %}
                                            <span class="badge badge-danger">{{'users.index.statusLbl.inactive'|trans}}</span>
                                        {% endif %}
                                    </td>
                                    
                                    <td class="py-1">
                                        <div class="" role="group" aria-label="Basic example">
                                            <a href="{{path('app_users_update', {'userId':user.id})}}" class="btn btn-warning btn-sm" type="button" data-bs-toggle="tooltip" data-bs-placement="top" title="Modifier">
                                               <i class="mdi mdi-pencil"></i>
                                            </a>
                                            <a href="{{path('app_users_machines', {'user':user.id})}}" class="btn btn-info btn-sm" type="button" data-bs-toggle="tooltip" data-bs-placement="top" title="Gérer les machines">
                                               <i class="mdi mdi-cog"></i>
                                            </a>
                                            {% if not user.password %}
                                                <a href="{{path('app_users_reset_password', {'user':user.id})}}" class="btn btn-primary btn-sm" type="button" data-bs-toggle="tooltip" data-bs-placement="top" title="Renvoyer l'email de creation mot de passe">
                                                <i class="mdi mdi-email"></i>
                                                </a>
                                            {% endif %}
                                            <form method="POST" action="{{path('app_users_toggle_status', {'userId':user.id})}}" style="display: inline;">
                                                <button type="submit" 
                                                    class="btn {% if user.isActive %}btn-secondary{% else %}btn-success{% endif %} btn-sm" 
                                                    data-bs-toggle="tooltip" 
                                                    data-bs-placement="top" 
                                                    title="{% if user.isActive %}{{'users.index.actionBtn.deactivate'|trans}}{% else %}{{'users.index.actionBtn.activate'|trans}}{% endif %}"
                                                    {% if app.user.id == user.id %}disabled{% endif %}
                                                >
                                                    <i class="mdi {% if user.isActive %}mdi-account-off{% else %}mdi-account-check{% endif %}"></i>
                                                </button>
                                            </form>
                                            <button type="button" 
                                                class="btn btn-danger btn-sm delete-user-btn" 
                                                data-bs-toggle="tooltip"
                                                data-bs-toggle="tooltip" data-bs-placement="top" title="Supprimer"
                                                {% if app.user.id == user.id %}disabled{% endif %}
                                                data-user-id="{{ user.id }}"
                                                data-user-name="{{ user.firstname ~ ' ' ~ user.lastname }}"
                                            >
                                                <i class="mdi mdi-delete"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if maxPages is defined and maxPages > 1 %}
                        {% include "components/shared/_pagination.html.twig" with { 'maxPages': maxPages, 'path':'app_users' } %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
<!-- Delete Confirmation Modal -->
{% include "components/_modal.html.twig" with {'context': 'users.index.contexte'|trans} %}
{% endblock %}

{% block script %}
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof jQuery !== 'undefined') {
                $('.delete-user-btn').click(function() {
                    var userId = $(this).data('user-id');
                    var userName = $(this).data('user-name');
                    $('#name').text(userName);
                    $('#deleteForm').attr('action', "{{path('app_users_delete', {'user': 'USERID'})}}".replace('USERID', userId));
                    $('#deleteConfirmationModal').modal('show');
                });
                $('.btn-secondary').click(function() {
                    $('#deleteConfirmationModal').modal('hide');
                });
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
                var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl)
                });
            } else {
                console.error('jQuery is not loaded!');
            }
        });
    </script>
{% endblock %}